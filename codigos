    var gi = 0;
    var ri = -1;

    function tabs(el, items, cur, fn) {
      el.innerHTML = items.map(function (t, i) {
        return '<button class="tab' + (i === cur ? ' on' : '') + '" data-i="' + i + '">' + t + '</button>';
      }).join('');

      [].forEach.call(el.children, function (b) {
        b.onclick = function () {
          fn(+b.dataset.i);
        };
      });
    }

    function drawS() {
      tabs(
        $('tabs'),
        G.map(function (g) {
          return g[1] + '<small>' + g[2].length + '</small>';
        }),
        gi,
        function (i) {
          gi = i;
          drawS();
        }
      );

      $('srv').innerHTML = G[gi][2].map(function (s, i) {
        return '<div class="card sv" style="--d:' + (i * 0.06) + 's"><div class="ic">' + G[gi][0] + '</div><h3>' + s[0] + '</h3><p>' + s[1] + '</p><button class="lk" data-s="' + s[0] + '">Solicitar →</button></div>';
      }).join('');

      [].forEach.call($('srv').querySelectorAll('.lk'), function (b) {
        b.onclick = function () {
          $('fs').value = b.dataset.s;
          $('contato').scrollIntoView();
          setTimeout(function () {
            $('fn').focus({ preventScroll: true });
          }, 500);
        };
      });

      hover();
    }

    function hover() {
      [].forEach.call(document.querySelectorAll('.card'), function (c) {
        c.onmousemove = function (e) {
          var r = c.getBoundingClientRect();
          c.style.setProperty('--x', e.clientX - r.left + 'px');
          c.style.setProperty('--y', e.clientY - r.top + 'px');
        };
      });
    }

    function drawC() {
      var q = $('q').value.trim().toLowerCase();
      var n = function (s) {
        return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      };

      var h = '';
      var t = 0;

      R.forEach(function (r, i) {
        if (ri > -1 && ri !== i) return;

        var cities = r[1].filter(function (c) {
          return n(c).indexOf(n(q)) > -1;
        });

        if (!cities.length) return;

        t += cities.length;

        h += '<div class="rt">' + r[0] + ' · ' + cities.length + '</div>';
        h += '<div class="chips">' + cities.map(function (c) {
          return '<button class="chip" data-c="' + c + '">' + c + '</button>';
        }).join('') + '</div>';
      });

      $('cities').innerHTML = h || '<p class="empty">Não encontrou sua cidade? Fale com a gente, estamos em expansão.</p>';

      [].forEach.call($('cities').querySelectorAll('.chip'), function (b) {
        b.onclick = function () {
          $('fc').value = b.dataset.c;
          $('contato').scrollIntoView();
        };
      });

      tabs(
        $('rt'),
        ['Todas'].concat(R.map(function (r) { return r[0]; })),
        ri + 1,
        function (i) {
          ri = i - 1;
          drawC();
        }
      );
    }

    $('fs').innerHTML = G.map(function (g) {
      return '<optgroup label="' + g[1] + '">' + g[2].map(function (s) {
        return '<option>' + s[0] + '</option>';
      }).join('') + '</optgroup>';
    }).join('');

    $('dl').innerHTML = R.map(function (r) {
      return r[1].map(function (c) {
        return '<option value="' + c + '">';
      }).join('');
    }).join('');

    $('q').oninput = drawC;

    $('f').onsubmit = function (e) {
      e.preventDefault();

      var mensagem = 'Olá! Meu nome é ' + $('fn').value + '. Vi o site da Consuater Escriturar e gostaria de um orçamento de: ' + $('fs').value + ($('fc').value ? ' (cidade: ' + $('fc').value + ')' : '') + '.';

      window.open('https://wa.me/' + $('fw').value + '?text=' + encodeURIComponent(mensagem), '_blank');
    };

    drawS();
    drawC();

    (function () {
      var hr = document.getElementById('top');
      var hb = $('hbg');
      var cl = $('cl');
      var sp = $('spot');
      var bn = [].slice.call(document.querySelectorAll('.bn'));

      if (matchMedia('(prefers-reduced-motion:reduce)').matches) return;

      hr.addEventListener('pointermove', function (e) {
        var r = hr.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width;
        var y = (e.clientY - r.top) / r.height;

        sp.style.setProperty('--mx', x * 100 + '%');
        sp.style.setProperty('--my', y * 100 + '%');

        hb.style.transform = 'translate(' + (.5 - x) * 26 + 'px,' + (.5 - y) * 18 + 'px)';
        cl.style.transform = 'translate(' + (x - 0.5) * 38 + 'px,' + (y - 0.5) * 24 + 'px)';

        bn.forEach(function (b) {
          var q = b.getBoundingClientRect();
          var dx = (e.clientX - q.left) / q.width - 0.5;
          var dy = (e.clientY - q.top) / q.height - 0.5;

          if (Math.abs(dx) < 1.2 && Math.abs(dy) < 1.2) {
            b.style.transform = 'perspective(700px) rotateY(' + dx * 14 + 'deg) rotateX(' + (-dy * 14) + 'deg) translateZ(8px)';
          } else {
            b.style.transform = '';
          }
        });
      });

      hr.addEventListener('pointerleave', function () {
        hb.style.transform = '';
        cl.style.transform = '';
        bn.forEach(function (b) {
          b.style.transform = '';
        });
      });
    })();

    (function () {
      var rm = matchMedia('(prefers-reduced-motion:reduce)').matches;

      document.querySelectorAll('section h2, .lead, .eye, .ib, form, .split>div:last-child').forEach(function (e, i) {
        e.classList.add('rv');
        e.style.setProperty('--d', (i % 3) * 0.08 + 's');
      });

      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('v');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.rv').forEach(function (e) {
        io.observe(e);
      });

      function cnt(el) {
        var n = +el.dataset.n;
        var s = el.dataset.s;
        var t0 = performance.now();

        if (rm) {
          el.textContent = n.toLocaleString('pt-BR') + s;
          return;
        }

        (function f(t) {
          var p = Math.min((t - t0) / 1700, 1);
          el.textContent = Math.round(n * (1 - Math.pow(1 - p, 3))).toLocaleString('pt-BR') + (p < 1 ? '' : s);

          if (p < 1) requestAnimationFrame(f);
        })(t0);
      }

      document.querySelectorAll('[data-n]').forEach(function (e) {
        cnt(e);
      });

      var bar = $('bar');
      var ls = [].slice.call(document.querySelectorAll('.pill nav a'));
      var ss = ls.map(function (a) {
        return document.querySelector(a.getAttribute('href'));
      });

      function sc() {
        var h = document.documentElement.scrollHeight - innerHeight;
        bar.style.transform = 'scaleX(' + (h > 0 ? scrollY / h : 0) + ')';

        var c = -1;
        ss.forEach(function (s, i) {
          if (s && s.getBoundingClientRect().top < innerHeight * 0.45) c = i;
        });

        ls.forEach(function (a, i) {
          a.classList.toggle('on', i === c);
        });
      }

      addEventListener('scroll', sc, { passive: true });
      sc();
    })();
