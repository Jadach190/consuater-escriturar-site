  </header>

  <div class="hero" id="top">
    <div class="hbg" id="hbg"></div>
    <div class="hov"></div>
    <svg class="cl" id="cl" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d="M-20 400C130 340 220 420 340 360S580 270 820 330"></path>
      <path d="M-20 340C140 280 230 360 340 305S580 215 820 270"></path>
      <path d="M-20 280C150 220 240 300 340 250S580 160 820 210"></path>
      <path d="M-20 220C160 160 250 240 340 195S580 105 820 150"></path>
