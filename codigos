          <a class="btn g" href="#servicos">Conhecer serviços</a>
        </div>
      </div>

      <div class="bento hi" style="--d:.45s">
        <div class="bn">
          <b data-n="14" data-s="+">0</b>
          <span>anos de experiência</span>
        </div>
        <div class="bn">
          <b data-n="5000" data-s="+">0</b>
          <span>clientes atendidos</span>
        </div>
        <div class="bn">
          <b data-n="54" data-s="+">0</b>
          <span>cidades na Bahia</span>
        </div>
      </div>
    </div>
  </div>

  <section id="servicos">
    <div class="w">
      <span class="eye">Serviços</span>
      <h2>Soluções organizadas por área</h2>
      <p class="lead">Escolha a área para ver os serviços. Clique em "Solicitar" para já preencher seu pedido.</p>
      <div class="tabs" id="tabs"></div>
      <div class="grid" id="srv"></div>
    </div>
  </section>

  <section id="cobertura" style="padding-top:0">
    <div class="w split">
      <div>
        <span class="eye">Cobertura</span>
        <h2>Mais de 54 cidades atendidas</h2>
