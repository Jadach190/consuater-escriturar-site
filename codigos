        <input class="search" id="q" placeholder="Digite o nome da sua cidade…" autocomplete="off">
        <div class="tabs" id="rt" style="margin:16px 0 0"></div>
      </div>

      <div>
        <div id="cities"></div>
      </div>
    </div>
  </section>

  <section class="dark" id="contato">
    <div class="w split">
      <div>
        <span class="eye">Contato</span>
        <h2>Peça seu orçamento</h2>
