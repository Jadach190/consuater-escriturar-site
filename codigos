<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Consuater Escriturar – Topografia, Geodésia e Regularização</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f6f7f4;
      --ink: #0e1a2b;
      --mut: #5d6b7a;
      --card: #fff;
      --line: #e2e6e1;
      --acc: #0f7a55;
      --acc2: #e0a82e;
      --navy: #0e1a2b;
      --on: #f3f6f4;
      --shadow: rgba(14, 26, 43, 0.12);
      --black: #000;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0a121d;
        --ink: #eaf0ee;
        --mut: #9aa8b6;
        --card: #111d2d;
        --line: #1f2f44;
        --acc: #2fc08a;
        --navy: #060c14;
      }
    }

    :root[data-theme="dark"] {
      --bg: #0a121d;
      --ink: #eaf0ee;
      --mut: #9aa8b6;
      --card: #111d2d;
      --line: #1f2f44;
      --acc: #2fc08a;
      --navy: #060c14;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: calc(env(safe-area-inset-top, 0px) + 84px);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font: 400 16px/1.6 Inter, system-ui, sans-serif;
    }

    h1, h2, h3 {
      font-family: Sora, system-ui, sans-serif;
      line-height: 1.12;
      margin: 0;
      letter-spacing: -0.02em;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .w {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 20px;
    }

    #bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 100%;
      transform-origin: 0 50%;
      transform: scaleX(0);
      background: linear-gradient(90deg, var(--acc), var(--acc2));
      z-index: 30;
    }

    header {
      position: fixed;
      top: calc(env(safe-area-inset-top, 0px) + 12px);
      left: 0;
      right: 0;
      z-index: 20;
      display: flex;
      justify-content: center;
      padding: 0 12px;
    }

    .pill {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 8px 7px 20px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--card) 82%, transparent);
      backdrop-filter: blur(14px);
      border: 1px solid var(--line);
      box-shadow: 0 8px 30px rgba(14, 26, 43, 0.12);
      max-width: 100%;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 6px;
      font: 800 16px Sora, sans-serif;
      margin-right: 14px;
      white-space: nowrap;
    }

    .lg {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #fff;
      object-fit: cover;
      margin-right: 4px;
    }

    .logo b {
      color: var(--acc);
    }

    .pill nav {
      display: flex;
      gap: 2px;
    }

    .pill nav a {
      font-size: 14px;
      font-weight: 500;
      color: var(--mut);
      padding: 8px 14px;
      border-radius: 999px;
      transition: 0.2s;
    }

    .pill nav a:hover,
    .pill nav a.on {
      background: color-mix(in srgb, var(--acc) 14%, transparent);
      color: var(--ink);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 0;
      cursor: pointer;
      font: 600 15px Inter, sans-serif;
      background: var(--acc);
      color: #fff;
      padding: 12px 22px;
      border-radius: 999px;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px color-mix(in srgb, var(--acc) 40%, transparent);
    }

    .btn.g {
      background: transparent;
      color: inherit;
      border: 1.5px solid color-mix(in srgb, currentColor 35%, transparent);
    }

    .btn.s {
      padding: 9px 18px;
      font-size: 14px;
    }

    .hero {
      background: radial-gradient(900px 500px at 85% 0, #14456b55, transparent), var(--navy);
      color: var(--on);
      padding: 140px 0 70px;
      position: relative;
      overflow: hidden;
    }

    .hbg {
      position: absolute;
      inset: -6%;
      background: var(--hero-img, none) center/cover no-repeat;
      opacity: 0.38;
      animation: kb 24s ease-in-out infinite alternate;
      transition: transform 0.25s ease-out;
    }

    @keyframes kb {
      to {
        scale: 1.08;
      }
    }

    .hov {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, var(--navy) 8%, rgba(6, 12, 20, 0.55) 60%, rgba(6, 12, 20, 0.25));
    }

    .spot {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(560px circle at var(--mx, 72%) var(--my, 30%), rgba(79, 224, 168, 0.2), transparent 60%);
    }

    .cl {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      fill: none;
      stroke: #e0a82e;
      stroke-opacity: 0.2;
      transition: transform 0.25s ease-out;
    }

    .cl path {
      stroke-dasharray: 1500;
      stroke-dashoffset: 1500;
      animation: dr 3.4s ease-out forwards;
    }

    .cl path:nth-child(2) {
      animation-delay: 0.2s;
    }

    .cl path:nth-child(3) {
      animation-delay: 0.4s;
    }

    .cl path:nth-child(4) {
      animation-delay: 0.6s;
    }

    .cl path:nth-child(5) {
      animation-delay: 0.8s;
    }

    @keyframes dr {
      to {
        stroke-dashoffset: 0;
      }
    }

    .bn {
      transform-style: preserve-3d;
      will-change: transform;
    }

    .scr {
      position: absolute;
      left: 50%;
      bottom: 18px;
      translate: -50% 0;
      width: 24px;
      height: 38px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-radius: 14px;
      z-index: 2;
    }

    .scr:after {
      content: "";
      position: absolute;
      left: 50%;
      top: 7px;
      width: 4px;
      height: 8px;
      margin-left: -2px;
      border-radius: 2px;
      background: var(--acc2);
      animation: sc 1.6s infinite;
    }

    @keyframes sc {
      50% {
        transform: translateY(10px);
        opacity: 0.2;
      }
    }

    .hero:before {
      z-index: 1;
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px);
      background-size: 26px 26px;
      mask-image: linear-gradient(#000, transparent 85%);
    }

    .hg {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
      align-items: center;
    }

    .tag {
      display: inline-block;
      font: 600 12px Inter;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--acc2);
    }

    .hero h1 {
      font-size: clamp(34px, 5.6vw, 60px);
      font-weight: 800;
      margin: 16px 0 18px;
    }

    .hero h1 span {
      background: linear-gradient(90deg, #4fe0a8, var(--acc2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      font-size: 18px;
      opacity: 0.82;
      max-width: 32em;
      margin: 0 0 28px;
    }

    .row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .bento {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .bn {
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      padding: 22px;
      backdrop-filter: blur(6px);
      transition: transform 0.3s, border-color 0.3s;
    }

    .bn:hover {
      transform: translateY(-4px);
      border-color: var(--acc2);
    }

    .bn:first-child {
      grid-column: span 2;
    }

    .bn b {
      display: block;
      font: 800 clamp(34px, 5vw, 50px) Sora, sans-serif;
      color: #fff;
    }

    .bn span {
      font-size: 13px;
      opacity: 0.7;
    }

    section {
      padding: 84px 0;
    }

    h2 {
      font-size: clamp(28px, 4.2vw, 42px);
      font-weight: 800;
      margin: 10px 0 10px;
    }

    .lead {
      color: var(--mut);
      max-width: 38em;
      margin: 0 0 32px;
    }

    .eye {
      font: 600 12px Inter;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--acc);
    }

    .tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 22px;
    }

    .tab {
      cursor: pointer;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--ink);
      font: 600 14px Inter;
      padding: 10px 18px;
      border-radius: 999px;
      transition: 0.2s;
    }

    .tab small {
      opacity: 0.55;
      margin-left: 6px;
      font-weight: 500;
    }

    .tab:hover {
      border-color: var(--acc);
    }

    .tab.on {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 14px;
    }

    .card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      overflow: hidden;
      transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    }

    .card:before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(260px circle at var(--x, 50%) var(--y, 0), color-mix(in srgb, var(--acc) 14%, transparent), transparent 60%);
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: var(--acc);
      box-shadow: 0 18px 36px rgba(14, 26, 43, 0.12);
    }

    .card:hover:before {
      opacity: 1;
    }

    .sv {
      animation: pop 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--d, 0s);
    }

    @keyframes pop {
      from {
        opacity: 0;
        transform: translateY(16px) scale(0.98);
      }
    }

    .ic {
      color: var(--acc);
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      font-size: 20px;
      background: color-mix(in srgb, var(--acc2) 20%, transparent);
      margin-bottom: 14px;
    }

    .card h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .card p {
      margin: 0 0 16px;
      font-size: 14px;
      color: var(--mut);
    }

    .lk {
      font: 600 14px Inter;
      color: var(--acc);
      cursor: pointer;
      background: none;
      border: 0;
      padding: 0;
    }

    .lk:hover {
      text-decoration: underline;
    }

    .split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: start;
    }

    .search {
      width: 100%;
      padding: 14px 18px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--ink);
      font: 500 16px Inter;
      outline: 0;
      transition: 0.2s;
    }

    .search:focus {
      border-color: var(--acc);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--acc) 18%, transparent);
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 16px;
    }

    .chip {
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--ink);
      font: 500 13px Inter;
      padding: 5px 12px;
      border-radius: 999px;
      cursor: pointer;
      transition: 0.2s;
    }

    .chip:hover {
      background: var(--acc);
      color: #fff;
      border-color: var(--acc);
      transform: translateY(-2px);
    }

    .rt {
      font: 700 13px Sora;
      margin: 18px 0 0;
      color: var(--mut);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .empty {
      color: var(--mut);
      margin-top: 16px;
    }

    .dark {
      background: var(--navy);
      color: var(--on);
    }

    .dark .lead {
      color: #a9b6c3;
    }

    .dark .eye {
      color: var(--acc2);
    }

    form {
      display: grid;
      gap: 12px;
    }

    label {
      font: 600 13px Inter;
      display: grid;
      gap: 6px;
    }

    .in {
      width: 100%;
      padding: 13px 14px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
      font: 400 15px Inter;
      outline: 0;
    }

    .in:focus {
      border-color: var(--acc2);
    }

    .in option {
      color: #111;
    }

    .info {
      display: grid;
      gap: 12px;
    }

    .ib {
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.05);
      border-radius: 18px;
      padding: 20px;
    }

    .ib h3 {
      font-size: 16px;
      margin-bottom: 6px;
    }

    .ib p {
      margin: 0;
      font-size: 14px;
      opacity: 0.85;
    }

    .ib a {
      color: var(--acc2);
      font-weight: 600;
    }

    footer {
      background: var(--navy);
      color: #a9b6c3;
      padding: 26px 0;
      font-size: 13px;
      border-top: 1px solid #ffffff14;
    }

    footer .w {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .rv {
      opacity: 0;
      transform: translateY(26px);
      transition: opacity 0.7s, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: var(--d, 0s);
    }

    .rv.v {
      opacity: 1;
      transform: none;
    }

    .fab {
      position: fixed;
      right: calc(18px + env(safe-area-inset-right, 0px));
      bottom: calc(18px + env(safe-area-inset-bottom, 0px));
      z-index: 15;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #25a244;
      display: grid;
      place-items: center;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
      transition: transform 0.25s;
    }

    .fab:hover {
      transform: scale(1.1);
    }

    .fab:before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: #25a244;
      animation: pulse 2.2s infinite;
      z-index: -1;
    }

    @keyframes pulse {
      to {
        transform: scale(1.8);
        opacity: 0;
      }
    }

    .hi {
      opacity: 0;
      transform: translateY(22px);
      animation: up 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards;
    }

    @keyframes up {
      to {
        opacity: 1;
        transform: none;
      }
    }

    @media (max-width: 860px) {
      .hg,
      .split {
        grid-template-columns: 1fr;
      }

      .pill nav {
        display: none;
      }

      .hero {
        padding: 120px 0 56px;
      }

      section {
        padding: 60px 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *:before, *:after {
        animation: none !important;
        transition: none !important;
      }

      .hi,
      .rv {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>
<body>
  <div id="bar"></div>

  <header>
    <div class="pill">
      <a class="logo" href="#top">
        <img class="lg" src="data:image/png;base64,码" alt="Logo Consuater Escriturar">
        CONSUATER <b>ESCRITURAR</b>
      </a>
      <nav>
        <a href="#servicos">Serviços</a>
