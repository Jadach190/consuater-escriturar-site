        <form id="f">
          <label>
            Seu nome
            <input class="in" id="fn" required>
          </label>

          <label>
            Serviço
            <select class="in" id="fs"></select>
          </label>

          <label>
            Cidade
            <input class="in" id="fc" list="dl" placeholder="Sua cidade">
          </label>
          <datalist id="dl"></datalist>

          <label>
            Falar com
            <select class="in" id="fw">
              <option value="5573999214943">Escritório</option>
              <option value="5573981830662">Moser Nascimento</option>
            </select>
          </label>

          <button class="btn" type="submit" style="justify-content:center">Enviar pelo WhatsApp →</button>
        </form>
      </div>

      <div class="info">
        <div class="ib">
          <h3>Endereço</h3>
          <p>
            Travessa Sinval Costa Reis, 78<br>
            Centro – Presidente Tancredo Neves – BA<br>
            CEP: 45416-000<br>
            <a href="https://www.google.com/maps/search/?api=1&query=Travessa+Sinval+Costa+Reis+78+Presidente+Tancredo+Neves+BA" target="_blank" rel="noopener">Ver no mapa →</a>
          </p>
